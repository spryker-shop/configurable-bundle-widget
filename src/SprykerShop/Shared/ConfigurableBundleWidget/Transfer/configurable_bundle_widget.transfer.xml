<?xml version="1.0"?>
<transfers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="spryker:transfer-01" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Quote">
        <property name="items" type="Item[]" singular="item"/>
    </transfer>

    <transfer name="Item">
        <property name="configuredBundleItem" type="ConfiguredBundleItem"/>
        <property name="configuredBundle" type="ConfiguredBundle"/>
        <property name="sumSubtotalAggregation" type="int"/>
        <property name="unitPrice" type="int"/>
        <property name="groupKey" type="string"/>
        <property name="quantity" type="int"/>
        <property name="brand" type="string" description="Brand of the product: its brand attribute in the order of the product storage, concrete localized over concrete over abstract localized over abstract, the localized ones in the current locale; set when the cart items are expanded."/>
        <property name="sku" type="string"/>
        <property name="abstractSku" type="string"/>
        <property name="name" type="string"/>
        <property name="abstractName" type="string" description="The name of the abstract product."/>
        <property name="selectedVariantAttributes" type="array" singular="selectedVariantAttribute" description="The super attributes of the concrete product, attribute key to value, ordered by attribute key as strings, e.g. {&quot;color&quot;: &quot;Red&quot;, &quot;storage_capacity&quot;: &quot;64 GB&quot;}; set when the item is added to the cart, and from the order item's super attributes when an order is read."/>
        <property name="categoryPath" type="string[]" singular="categoryName" description="The category names of the product, top level first, without the root category: set when the item is added to the cart, in the locale of that moment, and read from storage when the order details page shows an order item."/>
    </transfer>

    <transfer name="ConfiguredBundleCollection">
        <property name="configuredBundles" type="ConfiguredBundle[]" singular="configuredBundle"/>
    </transfer>

    <transfer name="ConfiguredBundle">
        <property name="template" type="ConfigurableBundleTemplate"/>
        <property name="quantity" type="int"/>
        <property name="groupKey" type="string"/>
        <property name="items" type="Item[]" singular="item"/>
    </transfer>

    <transfer name="ConfiguredBundleItem">
        <property name="slot" type="ConfigurableBundleTemplateSlot"/>
    </transfer>

    <transfer name="ConfigurableBundleTemplate">
        <property name="idConfigurableBundleTemplate" type="int"/>
        <property name="uuid" type="string"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="ConfigurableBundleTemplateSlot">
        <property name="idConfigurableBundleTemplateSlot" type="int"/>
        <property name="uuid" type="string"/>
    </transfer>

    <transfer name="UpdateConfiguredBundleRequest">
        <property name="quote" type="Quote"/>
        <property name="groupKey" type="string"/>
        <property name="quantity" type="int"/>
    </transfer>

    <transfer name="QuoteResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="QuoteError[]" singular="error"/>
    </transfer>

    <transfer name="QuoteError">
        <property name="message" type="string"/>
    </transfer>

    <transfer name="NumberFormatConfig">
    </transfer>

</transfers>
